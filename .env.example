# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api

ANTHROPIC_API_KEY=""
# or 
OPENAI_API_KEY=""

NEXT_PUBLIC_SUPABASE_URL=""

NEXT_PUBLIC_SUPABASE_ANON_KEY=""

SUPABASE_SERVICE_ROLE_KEY=""

# Assets (Demos and Posters) are served from a Cloudflare R2 bucket published on
# a custom domain. Contributors only need the public base URL below; the site
# renders correctly from it with no Assets checked out.
NEXT_PUBLIC_CDN_URL="https://cdn.rnui.dev"

# Maintainer only — required by `pnpm assets:publish`, never by the site.
# Bucket: rnui-assets. Token needs Account > Workers R2 Storage > Edit.
# See docs/r2-setup.md.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_TOKEN=""
R2_BUCKET="rnui-assets"