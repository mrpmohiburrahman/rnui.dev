# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=""

NEXT_PUBLIC_SUPABASE_ANON_KEY=""

SUPABASE_SERVICE_ROLE_KEY=""

# Assets (Demos and Posters) are served from a Cloudflare R2 bucket published on
# a custom domain. Contributors only need the public base URL below; the site
# renders correctly from it with no Assets checked out.
NEXT_PUBLIC_CDN_URL="https://cdn.rnui.dev"

# The Firestore collections holding the view and vote counts, and the newsletter
# signups. Set both. Leaving the first unset falls back to "rnui" — the production
# collection — so a local run counts against real numbers; lib/counters-firestore.ts
# warns when that happens, but the fix is here.
NEXT_PUBLIC_FIRESTORE_COLLECTION="rnui-dev"
NEXT_PUBLIC_FIRESTORE_EMAIL_COLLECTION="emails-dev"

# Maintainer only — uploads the production build's source maps to PostHog so
# error tracking resolves a stack trace to a real file and line. Leave both
# unset and the upload is skipped; the site builds and behaves identically.
# The key is a personal API key with `error tracking: write`, from
# https://us.posthog.com/settings/user-api-keys — not the NEXT_PUBLIC_ token.
# Set both on Vercel, not just locally, or production ships minified traces.
POSTHOG_API_KEY=""
POSTHOG_PROJECT_ID="117415"

# Maintainer only — required by `pnpm assets:publish`, never by the site.
# Bucket: rnui-assets. Token needs Account > Workers R2 Storage > Edit.
# See docs/r2-setup.md.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_TOKEN=""
R2_BUCKET="rnui-assets"