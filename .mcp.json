{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--viewport",
        "1440x900",
        "--no-category-network",
        "--screenshotFormat",
        "webp",
        "--screenshotMaxWidth",
        "1200",
        "--no-performance-crux",
        "--no-usage-statistics"
      ]
    }
  }
}
