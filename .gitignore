# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.env

# Staging copies of Assets. Demos and Posters are served from Cloudflare R2 and
# are never committed — see docs/adr/0001-assets-served-from-object-storage-not-the-repo.md.
# They stay at these paths so the catalogue's 554 Asset paths are unchanged and
# local development still serves media offline. Publish with `pnpm assets:publish`.
/public/demo/
/public/thumbnails/

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.turbo

__data__
**/stage-1-crawl/storage.env

.docusaurus

# Scratch worktrees created by coding agents. They hold a full checkout and a
# .next build, so eslint and vitest glob straight into them if they are tracked.
.claude/worktrees/

# Studio Dark before/after tour recordings (ticket 14). Megabytes of webm,
# reproducible from a commit sha plus tests/tour/catalogue.spec.ts — not source.
.scratch/studio-dark/recordings/

# The visual QA contact sheet — 21MB of PNG, same bargain as the recordings
# above: reproducible from `node scripts/visual-qa.mjs` against a build.
.scratch/studio-dark/visual-qa/

# Reproducible from scripts/checkpoint-13-lighthouse.mjs and -inp.mjs against two builds.
.scratch/studio-dark/lighthouse-*.json
.scratch/studio-dark/inp-*.json

# The scrubbed mailing list (notify-and-preview ticket 03). This repo is public
# and .scratch/ is tracked, so the one artifact that carries real addresses stays
# out of it — reproducible from `pnpm scrub:emails` against Firestore.
.scratch/notify-and-preview/research/*.local.json
